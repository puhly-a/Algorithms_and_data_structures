from math import acos 

def f(x):
  return acos((1-x**2)/(1+x**2)) - x #заданная функция

def xk(a,b):
  return a - (f(a)*(b-a))/(f(b)-f(a)) #формула для определения нового приближения корня

L,R = int(input()),int(input()) #ввод изначального отрезка (по условию 2 -> 3)

eps = 0.0001 #заданная погрешность


while True:
  new_x = xk(L,R)
  if new_x == 0 or abs(R-L) < eps: # если значение функции = 0 или расстояние между указателями меньше погрешности, значит корень найден
    break
  if f(L) * f(new_x) > 0:
    L = new_x
  else:
    R = new_x
print(new_x)


